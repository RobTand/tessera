__pycache__/
*.pyc
.pytest_cache/
.venv/
*.egg-info/

# agent worktrees
.claude/
dist/
*.egg-info/

# python -m build output
build/

# Coordinator scaffolding handed to worker agents; the venv path and the
# fleet lock directory are outside the repo, so it is not the repo test runner.
/run-tests.sh

# Worker scaffolding: reports and captured logs stay local.
/.claude/

# Agent working reports: local evidence, not tree artifacts (four branches
# committed one at the root before this was added).
/report.md

# PrismaBuild pool artifacts: pbrun writes these into the submitting
# checkout, so every box that submits a job leaves them behind and the next
# `git add -A` sweeps them into someone else's commit.
.pbrun-closure.*.json
pbrun_result.*.txt

# Torch JIT extension builds: a run that points TORCH_EXTENSIONS_DIR at the
# checkout (the pool submits from one) leaves a compiled .so and ninja logs
# here, and two commits on this branch swept them in before this line existed.
/.ext/
