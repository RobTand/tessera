+def payload_regime(meta: Mapping[str, Any]) -> str:
+    """The regime a dump payload declares; ``prefill`` when it declares none.
+
+    One reader for every consumer (``compare``, ``fingerprint``, a receipt
+    script), so "missing means prefill" is stated once and cannot drift into
+    two spellings that disagree about a legacy payload.
+    """
+    regime = (meta or {}).get("regime")
+    if regime is None:
+        return DEFAULT_REGIME
+    if isinstance(regime, str):
