+def _decode_warmup_body(model: str, prompt: list[int]) -> dict:
+    """The prefix-cache fill: one many-row forward, nothing scored off it.
+
+    No logprobs are requested, so this request cannot contribute a position to
+    the dump even by accident; it exists only so the NEXT requests hit whole
+    cached blocks.  It is also the one prefill forward the decode regime
+    performs per chunk, which is what makes the served prefill count
+    explainable (issue tessera#102 acceptance (a)).
+    """
+    return {"model": model, "prompt": prompt, "max_tokens": 1,
+            "temperature": 0.0, "add_special_tokens": False}
+
+
+def _decode_request_body(model: str, prompt: list[int], top_k: int) -> dict:
+    """One scored position: the distribution the serve samples the next token
+    from, over a prefix whose every token but the last is already cached."""
+    return {"model": model, "prompt": prompt, "max_tokens": 1,
+            "temperature": 0.0, "logprobs": top_k,
+            "return_tokens_as_token_ids": True,
+            "add_special_tokens": False}
+
+
+def _decode_rows_computed(payload: dict, *, prompt_len: int, stride: int,
+                          index: int) -> int:
+    """Rows the serve actually forwarded for this request, from ITS accounting.
+
+    ``usage.prompt_tokens_details.cached_tokens`` is the serve's own count of
+    prompt tokens served from the prefix cache; ``prompt_tokens - cached`` is
+    the number of rows the model ran.  Reading it is the difference between a
+    decode regime that is measured and one that is hoped for -- and the
+    failure it catches (a stride that is not the KV block size) is silent
+    otherwise: the dump would still be full of numbers, produced by up to
+    ``block_size``-row forwards.
+    """
+    usage = payload.get("usage") or {}
+    details = usage.get("prompt_tokens_details") or {}
+    cached = details.get("cached_tokens")
+    prompt_tokens = usage.get("prompt_tokens")
+    if prompt_tokens is None:
+        raise SystemExit(
+            "the serve returned no `usage.prompt_tokens` for a decode-regime "
+            "request; the regime cannot be verified and this dump would be an "
+            "assertion, not a measurement")
+    if cached is None:
+        raise SystemExit(
+            "the serve returned no `usage.prompt_tokens_details.cached_tokens`.\n"
+            "  * vLLM only fills that field when the serve was started with "
+            "`--enable-prompt-tokens-details`.\n"
+            "  * without it the M=1 claim of --regime decode cannot be checked "
+            "against the serve's own accounting, and an unchecked decode "
+            "regime is exactly the silent, directional failure this mode "
+            "exists to remove. Restart the serve with the flag.")
+    if int(prompt_tokens) != prompt_len:
+        raise SystemExit(
+            f"position {index}: the serve counted {prompt_tokens} prompt "
+            f"tokens, the request sent {prompt_len}. Check "
+            "`add_special_tokens`: a serve that prepends its own token is "
+            "scoring a different context than the corpus contract names")
+    rows = int(prompt_tokens) - int(cached)
+    if rows != 1:
+        raise SystemExit(
+            f"position {index}: the serve forwarded {rows} rows, not 1 "
+            f"({prompt_tokens} prompt tokens, {cached} from the prefix cache).\n"
+            f"  * --decode-stride is {stride}; it must equal the serve's KV "
+            "block size, because the prefix cache hits on whole blocks only.\n"
+            "  * or prefix caching is off on this serve (vLLM: "
+            "`--no-enable-prefix-caching` disables it), in which case every "
+            "request recomputes its whole prefix.\n"
+            "Refusing: a dump taken at M>1 is a prefill-regime dump wearing a "
+            "decode-regime label.")
+    return rows
+
+
+def _decode_scored_position(payload: dict, *, index: int) -> dict[int, float]:
+    """The scored distribution off a generation-logprobs response, by token id."""
+    choice = payload["choices"][0]
+    lp = choice.get("logprobs")
+    if not lp:
+        raise SystemExit(
+            f"position {index}: the serve returned no `logprobs` on the "
+            "generated token. --regime decode scores the SAMPLED position "
+            "(the only position an M=1 forward produces); the request asked "
+            "for `logprobs: K` and got nothing back.")
+    tops = lp.get("top_logprobs")
+    if not tops or not tops[0]:
+        raise SystemExit(
+            f"position {index}: the serve returned `logprobs` with no "
+            "`top_logprobs`; there is no distribution to score")
+    out: dict[int, float] = {}
+    for key, value in tops[0].items():
+        match = DECODE_TOKEN_ID_KEY.match(str(key))
+        if match is None:
+            raise SystemExit(
+                f"position {index}: the serve keyed its top_logprobs by token "
+                f"TEXT ({key!r}), not by token id.\n"
+                "  * the request sends `return_tokens_as_token_ids: true`; a "
+                "serve that ignores it is too old for this mode (vLLM also "
+                "accepts the server flag --return-tokens-as-token-ids).\n"
+                "  * refusing rather than decoding text back to ids: that map "
+                "is not injective, so the result would be a plausible wrong "
+                "distribution with no error anywhere.")
+        out[int(match.group(1))] = float(value)
+    return out
+
+
+def _decode_sweep(args: argparse.Namespace, chunks: list[list[int]],
+                  bos: int | None, top_k: int, requests_mod) -> tuple[
+                      list[dict[int, float]], dict[str, object]]:
+    """The decode-regime sweep: warm the prefix cache, then score at M=1.
+
+    Returns the scored rows and the regime record that travels in the dump's
+    metadata.  Requests are issued STRICTLY SEQUENTIALLY and that is part of
+    the regime's definition: two in flight at once would be batched into one
+    many-row forward by the serve's scheduler, which is the very thing being
+    avoided.
+    """
+    stride = int(args.decode_stride)
+    if stride < 1:
+        raise SystemExit("--decode-stride must be >= 1")
+    rows: list[dict[int, float]] = []
+    indices: list[list[int]] = []
+    cached_seen: list[int] = []
+    warmups = 0
+    t0 = time.time()
+    for ci, ch in enumerate(chunks):
+        full = ([bos] + list(ch)) if bos is not None else list(ch)
+        # (1) the prefix-cache fill.  One prefill forward per chunk.
+        resp = requests_mod.post(args.url,
+                                 json=_decode_warmup_body(args.model, full),
+                                 timeout=args.timeout)
+        if resp.status_code != 200:
+            raise SystemExit(f"chunk {ci} warm-up: HTTP {resp.status_code}: "
+                             f"{resp.text[:400]}")
+        warmups += 1
+        # (2) the scored positions.  L is the prefix length; the scored
+        # distribution predicts token L, so L < len(full) keeps every decode
+        # position a position the prefill regime also scores -- the two regimes
+        # then differ in the FORWARD, not in the conditioning.
+        chunk_idx: list[int] = []
+        for L in range(1, len(full), stride):
+            body = _decode_request_body(args.model, full[:L], top_k)
+            r = requests_mod.post(args.url, json=body, timeout=args.timeout)
+            if r.status_code != 200:
+                raise SystemExit(f"chunk {ci} prefix {L}: HTTP "
+                                 f"{r.status_code}: {r.text[:400]}")
+            payload = r.json()
+            _decode_rows_computed(payload, prompt_len=L, stride=stride,
+                                  index=len(rows))
+            usage = payload.get("usage") or {}
+            cached_seen.append(int((usage.get("prompt_tokens_details")
+                                    or {}).get("cached_tokens")))
+            rows.append(_decode_scored_position(payload, index=len(rows)))
+            chunk_idx.append(L)
+        indices.append(chunk_idx)
+        print(f"[dump] chunk {ci+1}/{len(chunks)} decode positions="
+              f"{len(chunk_idx)} k={len(rows[-1])} "
+              f"{time.time()-t0:.1f}s", flush=True)
+    per_chunk = sorted({len(i) for i in indices})
+    regime = {
+        "name": REGIME_DECODE,
+        "definition": (
+            "every scored position is an M=1 forward: the chunk's prefix is "
+            "fed incrementally with the serve's prefix cache on, and the "
+            "scored distribution is the one the serve sampled the next token "
+            "from"),
+        "request": ("max_tokens=1, logprobs=K, temperature=0, "
+                    "return_tokens_as_token_ids=true, sequential"),
+        "stride": stride,
+        "stride_note": ("must equal the serve's KV block size; the prefix "
+                        "cache hits on whole blocks only"),
+        "prefix_lengths": indices,
+        "positions_per_chunk": per_chunk,
+        "scored_positions": len(rows),
+        "warmup_prefills": warmups,
+        "warmup_note": ("one many-row prefill per chunk, scoring nothing: the "
+                        "only prefill forward this regime performs"),
+        "rows_per_scored_forward": 1,
+        "rows_verified_by": ("usage.prompt_tokens_details.cached_tokens on "
+                             "every scored request"),
+        "cached_tokens_min": min(cached_seen) if cached_seen else None,
+        "cached_tokens_max": max(cached_seen) if cached_seen else None,
+        "positions_are_subset_of_prefill": True,
+        "comparability": ("NOT comparable to a prefill-regime dump: same "
+                          "corpus and conditioning, different executed "
+                          "kernels and a coarser position set"),
+    }
+    return rows, regime
+
