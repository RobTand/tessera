+def payload_fingerprint(path: str | Path) -> dict[str, object]:
+    """The content hash of a dump: the numbers plus the metric's identity.
+
+    Two dumps of the same corpus off the same served bytes in the same regime
+    have the same fingerprint, and any change to the scored values, the
+    support, the corpus, the tokenizer or the regime changes it.  A legacy
+    payload carrying no regime field fingerprints as ``prefill``, which is
+    what it is, so a dump taken before the regime field existed and one taken
+    after it are comparable by this digest.
+    """
